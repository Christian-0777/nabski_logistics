# Gemini workspace ignore rules for the NLSI telemetry project
# This file is intended to stay local; only README.md should be tracked/pushed.

# Build and generated output
build/
build-*/
cmake-build-*/
out/
dist/
release/
releases/
staging/
installer/output/
installer/temp/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
*.ninja
.ninja_deps
.ninja_log

# C/C++ and Visual Studio artifacts
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.idb
*.ipch
*.pch
*.exp
*.tlog
*.lastbuildstate
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# IDE settings
.vscode/
.idea/

# Qt generated files
moc_*.cpp
ui_*.h
qrc_*.cpp
*.qmlc
*.jsc

# Python caches/virtual environments if helper scripts are used
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
secrets/
**/secrets/
*.secret
*.pem
*.key
*.p12
*.pfx
credentials.json
token.json

# Logs, dumps, and local runtime data
*.log
*.dmp
*.mdmp
logs/
data/
*.jsonl

# Temporary / backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*.old
*~

# Game/SDK extracted binaries and local SDK packages (review licensing before sharing)
scs_sdk_*/
SCS_SDK*/
