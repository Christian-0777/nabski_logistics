            VALUE "OriginalFilename", "nlsi_dashboard.exe\0"
            VALUE "ProductName", "NLSI Exclusive Logbook\0"
            VALUE "ProductVersion", "1.7.4 Beta\0"
        END
    END
    BLOCK "VarFileInfo"
